spring:
  datasource:
    url: jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
    username: ${DB_USERNAME:your-db-user}
    password: ${DB_PASSWORD:your-db-password}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
    baseline-version: 2
  session:
    store-type: jdbc
    jdbc:
      initialize-schema: never
    timeout: 30d
  threads:
    virtual:
      enabled: true
  mail:
    host: smtp.gmail.com
    port: 587
    username: schwalmtalzupfer@gmail.com
    password: ${MAIL_PASSWORD}        # Google App-Passwort (siehe unten)
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true
      mail.smtp.starttls.required: true
      mail.smtp.connectiontimeout: 5000
      mail.smtp.timeout: 5000

app:
  cors:
    # Komma-getrennte Liste erlaubter Origins (die öffentliche URL der App + localhost für Dev)
    allowed-origins: ${APP_CORS_ORIGINS:https://schwalmtalzupfer.de,https://159.195.70.118.nip.io,http://localhost:3000,https://localhost:3000}
  security:
    aes-key: ${APP_SECURITY_AES_KEY:dein-32-zeichen-schluessel-hier!}
  jwt:
    # Mind. 32 Zeichen (HS256) - für die native App (mobiler Login, kein Session-Cookie)
    secret: ${APP_JWT_SECRET:bitte-mindestens-32-zeichen-langes-geheimnis-hier}
    expiration-ms: ${APP_JWT_EXPIRATION_MS:2592000000} # 30 Tage
  stripe:
    secret-key: ${STRIPE_SECRET_KEY:sk_test_...}
    publishable-key: ${STRIPE_PUBLISHABLE_KEY:pk_test_...}
    webhook-secret: ${STRIPE_WEBHOOK_SECRET:whsec_...}
  r2:
    endpoint: ${R2_ENDPOINT:https://<ACCOUNT_ID>.r2.cloudflarestorage.com}
    access-key: ${R2_ACCESS_KEY:your-r2-access-key}
    secret-key: ${R2_SECRET_KEY:your-r2-secret-key}
    bucket: ${R2_BUCKET:your-bucket-name}
    public-url: ${R2_PUBLIC_URL:}
  invitation:
    base-url: ${APP_BASE_URL:http://localhost:8080}
    token-validity-hours: 72
  mail:
    from: ${MAIL_FROM_ADDRESS:noreply@schwalmtalzupfer.de}
    to: ${MAIL_TO_ADDRESS:simon.lankes@gmx.de}

server:
  port: 8080

